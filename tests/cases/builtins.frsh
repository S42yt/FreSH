suite builtins

parse_flags() {
  local seen=""
  local OPTIND=1
  while getopts ab:c flag; do
    seen="$seen[$flag${OPTARG:+=$OPTARG}]"
  done
  echo "$seen"
}
check getopts_simple "$(parse_flags -a)" '[a]'
check getopts_argument "$(parse_flags -b value)" '[b=value]'
check getopts_clustered "$(parse_flags -ac)" '[a][c]'
check getopts_mixed "$(parse_flags -a -b two -c)" '[a][b=two][c]'

start=$(pwd)
pushd . > /dev/null
check pushd_returns_zero "$?" 0
popd > /dev/null
check popd_restores "$(pwd)" "$start"
check dirs_prints "$(dirs | wc -w | tr -d ' ')" 1

check random_in_range "$(test $RANDOM -ge 0 && test $RANDOM -lt 32768 && echo yes)" yes
check seconds_counts "$(test $SECONDS -ge 0 && echo yes)" yes
lineno_here=$LINENO
check lineno_tracks_file "$(test "$lineno_here" -gt 20 && echo yes)" yes

named() { echo "$FUNCNAME"; }
check funcname_inside "$(named)" named
check funcname_outside "${FUNCNAME:-none}" none

false | true
check pipestatus_first "${PIPESTATUS[0]}" 1
check pipestatus_last "${PIPESTATUS[1]}" 0
true | false
check pipestatus_second "${PIPESTATUS[1]}" 1

printf -v captured '%05.1f' 3.14159
check printf_into_variable "$captured" 003.1
printf -v joined '%s-%s' a b
check printf_into_variable_two "$joined" a-b

check mapfile_count "$(printf 'a\nb\nc\n' | { mapfile -t rows; echo ${#rows[@]}; })" 3
check mapfile_element "$(printf 'a\nb\n' | { mapfile -t rows; echo ${rows[1]}; })" b
check readarray_alias "$(printf 'x\n' | { readarray -t r; echo ${r[0]}; })" x

echo contents > .fresh-test-read
check dollar_less_than "$(<.fresh-test-read)" contents
rm .fresh-test-read

check case_fallthrough "$(case a in a) echo one ;& b) echo two ;; c) echo three ;; esac | tr '\n' ' ')" 'one two '
check case_stops_at_break "$(case c in a) echo one ;& c) echo three ;; esac)" three
check case_inside_substitution "$(case hello in h*) echo matched ;; esac)" matched

check time_reports "$( { time true ; } 2>&1 | grep -c real )" 1

printf '%s' '[{"tag_name":"v99.2.0-prerelease-1","prerelease":true},{"tag_name":"v99.2.0-experiment-1","prerelease":true},{"tag_name":"v99.1.0-prerelease-2","prerelease":true},{"tag_name":"v99.0.0","prerelease":false}]' > .fresh-test-releases
export FRESH_RELEASES_JSON=.fresh-test-releases
listing=$(fresh update --selector --check)
offer=$(fresh update --pre --check)
unset FRESH_RELEASES_JSON
rm .fresh-test-releases

case "$listing" in *"99.2.0 prerelease 1"*) pre=yes ;; *) pre=no ;; esac
check selector_lists_prereleases "$pre" yes
case "$listing" in *"99.2.0 experiment 1"*) exp=yes ;; *) exp=no ;; esac
check selector_lists_experiments "$exp" yes
case "$listing" in *"99.1.0 prerelease 2"*) old=yes ;; *) old=no ;; esac
check selector_lists_older_versions "$old" yes
case "$listing" in *"99.0.0 release"*) stable=yes ;; *) stable=no ;; esac
check selector_lists_releases "$stable" yes
case "${listing#*99.2.0 prerelease 1}" in *"99.0.0 release"*) ordered=yes ;; *) ordered=no ;; esac
check selector_newest_first "$ordered" yes
case "$listing" in *"4 releases"*|*" 4"*) count=yes ;; *) count=no ;; esac
check selector_shows_all "$count" yes
case "$offer" in *"99.2.0-prerelease-1"*) offered=yes ;; *) offered=no ;; esac
check pre_offers_newest_prerelease "$offered" yes
case "$offer" in *"99.2.0-experiment"*) leaked=yes ;; *) leaked=no ;; esac
check pre_skips_experiments "$leaked" no

case "$PATH" in *[Ss]ystem32*) merged=yes ;; *) merged=no ;; esac
check path_merge_on_first_read "$merged" yes
check path_resolves_commands "$(command -v cmd > /dev/null && echo yes)" yes

reader() {
  local first second
  read -r first
  probe=$(cat <<< "buffered")
  read -r second
  printf '%s+%s' "$first" "$second"
}
check read_survives_redirect "$(printf 'one\ntwo\n' | reader)" "one+two"

( while :; do sleep 0.1; done ) &
spin=$!
check bang_expands_to_pid "$(test -n "$spin" && test "$spin" != '$!' && echo yes)" yes
kill "$spin" 2> /dev/null
check background_loop_killable "$?" 0
wait "$spin" 2> /dev/null
check wait_returns_after_kill yes yes

BG_GREETING=hidden
bg_out=.bg-capture
greet_bg() { printf '%s' "$BG_GREETING"; }
( greet_bg ) > "$bg_out" &
wait $! 2> /dev/null
check background_sees_functions_and_vars "$(cat $bg_out)" hidden
rm -f "$bg_out"

cleared=$(clear)
check clear_sequence "$cleared" "$(printf '\033[H\033[2J\033[3J')"
check clear_erases_scrollback "$(printf '%s' "$cleared" | grep -c '3J')" 1