suite shortcuts

base=$(pwd)
tree=.fresh-test-shortcuts
rm -r "$tree" 2> /dev/null
mkdir -p "$tree/alpha/inner" "$tree/beta"

cd "$tree/alpha/inner"
cd "$base"
cd "$tree/beta"
cd "$base"

check jump_lists "$(z | grep -c fresh-test-shortcuts)" 2
check jump_moves "$(z alpha inner > /dev/null; pwd | grep -c inner)" 1
cd "$base"
check jump_reports_missing "$(z nowhere-at-all 2>&1 | grep -c remembered)" 1

check autocd_enters "$($tree/beta > /dev/null; pwd | grep -c beta)" 1
cd "$base"
check autocd_off "$(FRESH_AUTOCD=0; $tree/beta 2>&1 | grep -c 'command not found')" 1
cd "$base"

if on_windows || command -v pbcopy > /dev/null; then
  check clipboard_roundtrip "$(copy fresh-clipboard-test; paste)" fresh-clipboard-test
  check clipboard_from_pipe "$(echo piped-in | copy; paste)" piped-in
fi

echo packed > "$tree/file.txt"
tar -c -f "$tree/bundle.tar" -C "$tree" file.txt 2> /dev/null
extract "$tree/bundle.tar" "$tree/unpacked" > /dev/null 2>&1
check extract_tar "$(cat "$tree/unpacked/file.txt" 2> /dev/null)" packed
check extract_unknown "$(extract "$tree/file.txt" 2>&1 | grep -c 'unknown archive')" 1

cd "$base"
rm -r "$tree"
