suite bashisms

items=(alpha beta)
check array_replace "${items[*]/a/X}" "Xlpha betX"
check array_strip "${items[*]#a}" "lpha beta"
check array_upper "${items[*]^^}" "ALPHA BETA"

prefixed_one=1
prefixed_two=2
check names_by_prefix "$(echo ${!prefixed*})" "prefixed_one prefixed_two"

word=hi
check transform_upper "${word@U}" HI
check transform_lower "${word@L}" hi
check transform_quote "${word@Q}" "'hi'"

set -- a b c d
check positional_slice "$(echo ${@:2:2})" "b c"
check positional_rest "$(echo ${@:3})" "c d"
check positional_count "${#@}" 4

if [[ abc =~ a(b)(c) ]]; then
  check regex_group_one "${BASH_REMATCH[1]}" b
  check regex_group_two "${BASH_REMATCH[2]}" c
fi

check based_number "$((2#1010))" 10
check based_hex "$((16#ff))" 255

check declare_prints "$(x=1; declare -p x | grep -c 'x=')" 1
check export_prints "$(export EXPORTED_ONE=1; export -p | grep -c '^export EXPORTED_ONE=')" 1

check command_v "$(command -v echo > /dev/null && echo found)" found
echo() { printf 'shadowed\n'; }
check function_shadows "$(echo hi)" shadowed
check command_bypasses "$(command echo hi)" hi
check builtin_bypasses "$(builtin echo hi)" hi
unset -f echo
check unset_f_removes "$(echo hi)" hi

readonly LOCKED=first
check readonly_holds "$(LOCKED=second 2>/dev/null; echo $LOCKED)" first

check type_kind_builtin "$(type -t echo)" builtin
check type_kind_function "$(f(){ :; }; type -t f)" function

check last_argument "$(echo one two > /dev/null; echo $_)" two

shopt -s nocasematch
check nocasematch_on "$(case ABC in abc) echo yes ;; *) echo no ;; esac)" yes
shopt -u nocasematch
check nocasematch_off "$(case ABC in abc) echo yes ;; *) echo no ;; esac)" no

check ifs_splitting "$(IFS=:; set -- $(echo a:b:c); echo $#)" 3

esc=$(printf '\033')
seq="${esc}[2J"
case "$seq" in *"[2J"*) quoted_class=yes ;; *) quoted_class=no ;; esac
check case_quoted_brackets_are_literal "$quoted_class" yes
case "abc" in "[abc]") literal_class=yes ;; *) literal_class=no ;; esac
check case_quoted_class_matches_itself "$literal_class" no
case "[abc]" in "[abc]") exact=yes ;; *) exact=no ;; esac
check case_quoted_class_matches_text "$exact" yes
case "a" in [abc]) unquoted=yes ;; *) unquoted=no ;; esac
check case_unquoted_class_still_matches "$unquoted" yes

star='a*b'
case "$star" in "a*b") quoted_star=yes ;; *) quoted_star=no ;; esac
check case_quoted_star_is_literal "$quoted_star" yes
case "axxb" in "a*b") wrong=yes ;; *) wrong=no ;; esac
check case_quoted_star_does_not_glob "$wrong" no

check bracket_quoted_pattern_literal "$([[ "[2J" == "[2J" ]] && echo yes || echo no)" yes
check bracket_quoted_pattern_not_class "$([[ "2" == "[2J]" ]] && echo yes || echo no)" no
check bracket_unquoted_pattern_globs "$([[ abc == a* ]] && echo yes || echo no)" yes

pat='[2J'
value="x[2Jy"
check strip_quoted_prefix "${value#"x[2J"}" y